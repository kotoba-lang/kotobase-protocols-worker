;; Seed a local git repository into the git surface of a deployed
;; kotobase-protocols worker (ADR-2607176000), making it clonable over
;; git's dumb-HTTP transport:
;;
;;   KOTOBASE_WRITE_TOKEN=… nbb bin/seed_git.cljk \
;;     <local-repo-path> <remote-repo-path> <base-url>
;;   # e.g. … . kotoba-lang/kotobase-protocols https://git.kotobase.net
;;
;; Every reachable object is re-encoded as a zlib loose object (dumb
;; clients cannot read packs), base64-ed for transport, and PUT behind
;; the worker's write auth. Refs and HEAD follow.
(ns seed-git
  (:require ["child_process" :as cp]
            ["zlib" :as zlib]
            [clojure.string :as str]))

(def repo (nth *command-line-args* 0))
(def remote (nth *command-line-args* 1))
(def base (nth *command-line-args* 2))
(def token (or (.-KOTOBASE_WRITE_TOKEN js/process.env)
               (throw (ex-info "KOTOBASE_WRITE_TOKEN not set" {}))))

(defn- sh-str [& args]
  (str/trim (cp/execFileSync "git" (clj->js (cons "-C" (cons repo args)))
                             #js {:encoding "utf8" :maxBuffer 104857600})))

(defn- sh-buf [& args]
  (cp/execFileSync "git" (clj->js (cons "-C" (cons repo args)))
                   #js {:maxBuffer 104857600}))

(defn- put! [path body headers]
  (-> (js/fetch (str base "/" path)
                (clj->js {:method "PUT"
                          :headers (merge {"authorization" (str "Bearer " token)} headers)
                          :body body}))
      (.then (fn [res]
               (when-not (.-ok res)
                 (throw (ex-info (str "PUT " path " -> " (.-status res)) {})))
               res))))

(defn- loose-object [sha]
  (let [otype (sh-str "cat-file" "-t" sha)
        content (sh-buf "cat-file" otype sha)
        header (js/Buffer.from (str otype " " (.-length content) "\u0000"))]
    (.toString (zlib/deflateSync (js/Buffer.concat #js [header content])) "base64")))

(def shas
  (->> (str/split-lines (sh-str "rev-list" "--objects" "--all"))
       (map #(first (str/split % #"\s")))
       (remove str/blank?)
       distinct
       vec))

(def refs
  ;; refs/remotes/*/HEAD is a SYMBOLIC ref — %(objectname) comes back
  ;; empty for it (no 40-hex sha to PUT), so `for-each-ref` here filters
  ;; to refname-and-sha pairs only, skipping symrefs the server's
  ;; refs endpoint (which stores one 40-hex sha per refname) can't
  ;; represent anyway. The repo's OWN HEAD symref is handled separately
  ;; below via `symbolic-ref`, not through this list.
  (->> (str/split-lines (sh-str "for-each-ref" "--format" "%(objectname) %(refname)"))
       (remove str/blank?)
       (map #(str/split % #"\s" 2))
       (filter (fn [[sha _]] (re-matches #"[0-9a-f]{40}" sha)))
       vec))

(println "seeding" (count shas) "objects," (count refs) "refs from" repo "->" base "/" remote)

(-> (reduce (fn [p sha]
              (.then p (fn [_]
                         (put! (str remote "/objects/" (subs sha 0 2) "/" (subs sha 2))
                               (loose-object sha)
                               {"x-kotobase-body" "base64"}))))
            (js/Promise.resolve nil)
            shas)
    (.then (fn [_]
             (reduce (fn [p [sha refname]]
                       (.then p (fn [_] (put! (str remote "/" refname) sha {}))))
                     (js/Promise.resolve nil)
                     refs)))
    (.then (fn [_] (put! (str remote "/HEAD")
                         (str "ref: " (sh-str "symbolic-ref" "HEAD") "\n") {})))
    (.then (fn [_] (println "seeded: " (count shas) "objects," (count refs)
                            "refs, HEAD ->" (sh-str "symbolic-ref" "HEAD"))))
    (.catch (fn [e] (println "FAILED:" (.-message e)) (set! (.-exitCode js/process) 1))))
