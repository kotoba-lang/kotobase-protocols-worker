;; Deploy shell for kotoba-lang/kotobase-protocols (ADR-2607174500).
;; Library deps are consumed as shadow source-paths from the west checkout
;; (same pattern as kotobase-cljc-worker), relative to
;; orgs/kotoba-lang/kotobase-protocols-worker → orgs/kotoba-lang/<dep>.
;; Build: amu compile --target wasm32-browser worker → out/worker.js (:esm, default
;; export {fetch}) — run through scripts/resource-guard.mjs in the
;; superproject (repo-wide build governor).
{:source-paths
 ["src"
  "test"
  ;; AWS SigV4 (ADR-2607254100): the shared signer/verifier. This repo
  ;; carried the verification half, which percent-encoded with charCodeAt
  ;; and so signed non-ASCII as UTF-16.
  "../sigv4/src"
  "../kotobase-protocols/src"
  "../kotobase/src"
  ;; CACAO verify (ADR-2607177000): kotobase-client is the byte-exact
  ;; mint/verify implementation the kotobase.net edge already uses
  ;; (kotobase-cljc-worker). cljs-only (not .cljc) — @noble/curves has
  ;; no JVM analogue here.
  "../kotobase-client/src"
  ;; Real datom-plane engine (ADR-2607177500), same dep chain
  ;; kotobase-cljc-worker itself consumes as sibling source-paths.
  "../kotobase-peer/src"
  "../datom/src"
  "../arrangement/src"
  "../prolly-tree/src"
  "../chain/src"
  "../io-ipld/src"
  "../io-multiformats/src"
  "../org-ietf-cbor/src"]

 :dependencies []

 :builds
 {:worker {:target :esm
           :output-dir "out"
           ;; Serialize compilation: parallel par-compile aborts
           ;; ("still waiting for #{cljs.core}") under host CPU
           ;; contention from concurrent agent builds on this machine.
           :compiler-options {:parallel-build false}
           :modules {:worker {:exports {default kotobase-protocols-worker.worker/handler}}}}
  ;; node-test, not nbb: CACAO verify needs real @noble/curves/@ipld/dag-cbor
  ;; npm modules — same choice kotobase-client's own test suite makes, and
  ;; cljs ranks above nbb in the repo-wide runtime priority anyway.
  :test {:target :node-test
         :output-to "out/node-tests.js"
         :ns-regexp "-test$"
         :compiler-options {:parallel-build false}}}}
